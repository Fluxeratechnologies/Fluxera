# ─────────────────────────────────────────────
# FLUXERA V1 — ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# DATABASE (PostgreSQL on AWS RDS or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/fluxera

# SERVER
PORT=3000
NODE_ENV=production

# SECURITY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=your_random_secret_here
CRON_SECRET=your_cron_secret_here

# EMAIL (use Resend, SendGrid, or plain SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
EMAIL_FROM=reports@fluxeratechnologies.ai
EMAIL_FROM_NAME=Fluxera Technologies

# PROCESSOR (how often to run — default: every hour)
PROCESSOR_SCHEDULE="0 * * * *"

# REPORT (when to send daily email — default: 8am UTC)
REPORT_SCHEDULE="0 8 * * *"
